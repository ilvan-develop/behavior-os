{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "behavior-os": ["./src/index.ts"],
      "behavior-os/domain": ["./src/domain/types.ts"],
      "behavior-os/ports": ["./src/domain/ports.ts"],
      "behavior-os/workflow": ["./src/workflow/engine.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", ".opencode/tools/**/*", ".opencode/plugins/**/*"],
  "exclude": ["node_modules", "dist", "graphify-out"]
}
