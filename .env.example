# behaviorOS — env example (never commit .env)
# Graphify backends (only for headless extraction, not for /graphify inside IDE)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenCode provider override (optional)
OPENCODE_CONFIG_CONTENT=
# Evidence
BEHAVIOR_OS_RUNTIME_DIR=behavior-os/runtime
# Context7 MCP (local default uses env placeholder, nunca token literal)
CONTEXT7_API_KEY=YOUR_API_KEY
