{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "external_directory": {
      "behavior-os/**": "allow",
      "graphify-out/**": "allow",
      ".opencode/**": "allow",
      "dnas/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python *": "allow",
      "graphify *": "allow"
    }
  },
  "plugin": [
    "./.opencode/plugins/behaviorOS.ts"
  ],
  "plugins": [
    "./.opencode/plugins/behaviorOS.ts"
  ]
}