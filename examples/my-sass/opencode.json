{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },
  "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "lsp": "allow"
  },
  "plugin": [
    "./.opencode/plugins/behaviorOS.ts"
  ],
  "plugins": [
    "./.opencode/plugins/behaviorOS.ts"
  ]
}