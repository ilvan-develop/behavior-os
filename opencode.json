{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },
  "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "question": "allow",
    "lsp": "allow"
  },
  "agent": {
    "orchestrator": {
      "description": "Orchestrates behaviorOS workflows and delegates to specialist subagents",
      "mode": "primary",
      "permission": {
        "task": "allow",
        "edit": "allow"
      }
    }
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "command": {
    "doctor": {
      "template": "Run the behaviorOS doctor gate: check AGENTS.md, .opencode structure, behavior-os config and evidence ledger. Report PASS/FAIL per gate.",
      "description": "behaviorOS health gate",
      "agent": "orchestrator"
    },
    "demo": {
      "template": "Execute the behaviorOS demo mission: install → typecheck → tests → mission → evidence → graphify detection. Produce evidence in behavior-os/runtime/",
      "description": "Run behaviorOS demo",
      "agent": "orchestrator"
    }
  },
  "plugin": [
    "./.opencode/plugins/behaviorOS.ts"
  ]
}